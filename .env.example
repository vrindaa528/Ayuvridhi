# Copy this file to .env and fill in what you need.
PORT=3000
DEMO_MODE=1
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=data/aayuvridhi.db
TZ=Asia/Kolkata

# ---- Real OTP by SMS (leave SMS_PROVIDER empty to print OTPs in the console) ----
# Option A: Twilio Verify (easiest for testing on your own phone)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Option B: MSG91 (production in India; needs a DLT-approved OTP template)
# SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
