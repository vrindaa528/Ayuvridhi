# Copy this file to .env and fill in what you need.
PORT=3000
DEMO_MODE=1
# Required when DEMO_MODE=0: at least 32 random characters (e.g. `openssl rand -hex 32`).
# The server refuses to start without it. Also keys the OTP and delivery-code hashes.
JWT_SECRET=change-me-to-a-long-random-string
# 1 = trust X-Forwarded-For for the client IP (only behind a proxy you control)
TRUST_PROXY=0
DB_PATH=data/aayuvridhi.db
TZ=Asia/Kolkata

# ---- Real OTP by SMS (leave SMS_PROVIDER empty to print OTPs in the console) ----
# Option A: Twilio Verify (easiest for testing on your own phone)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Option B: MSG91 (production in India; needs a DLT-approved OTP template)
# SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
